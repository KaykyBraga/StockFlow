<Page x:Class="StockFlow.Visual.Produtos.CadastrarProduto"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:StockFlow"
      mc:Ignorable="d"
      Title="CadastroProdutoPage" Background="White">

    <Page.Resources>
        <Style x:Key="BlueActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF33ADFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF2182C3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BlueActionButtonStyle}">
            <Setter Property="Background" Value="#FF1890E0"/>
            <Setter Property="Height" Value="40"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF0368AB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#8C8C8C"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" SnapsToDevicePixels="True">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Tag}" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource AncestorType=TextBox}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="#7EB4EA"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="#1C86EE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupCancelButtonStyle" TargetType="Button" BasedOn="{StaticResource BlueActionButtonStyle}">
            <Setter Property="Background" Value="#FFAAAAAA"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource BlueActionButtonStyle}">
            <Setter Property="Background" Value="#28a745"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#218838"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ErrorButtonStyle" TargetType="Button" BasedOn="{StaticResource BlueActionButtonStyle}">
            <Setter Property="Background" Value="#dc3545"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#c82333"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="30,30,0,30">
                <Button Style="{StaticResource BackButtonStyle}" Click="BackButton_Click">
                    <ContentControl>
                        <Path Data="M10 0 L0 10 L10 20 Z" Fill="#555" Width="10" Height="20" Stretch="Fill"/>
                    </ContentControl>
                </Button>
                <TextBlock Text="Cadastro de Produto" FontSize="28" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center" Margin="15,0,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="30,0,30,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,10">
                        <TextBlock Text="Nome Produto" Margin="0,0,0,5"/>
                        <TextBox Height="30" x:Name="txtNomeProduto"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="Unidade de Medida" Margin="0,0,0,5"/>
                        <ComboBox Height="30"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,15,10">
                        <TextBlock Text="Preço de Custo" Margin="0,0,0,5"/>
                        <TextBox Height="30"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="Estoque Inicial" Margin="0,0,0,5"/>
                        <TextBox Height="30"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,15,10">
                        <TextBlock Text="Preço de Venda" Margin="0,0,0,5"/>
                        <TextBox Height="30"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="Estoque Mínimo" Margin="0,0,0,5"/>
                        <TextBox Height="30"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Grid.Column="0" Margin="0,0,0,0">
                        <TextBlock Text="Descrição do Produto" Margin="0,0,0,5"/>
                        <TextBox AcceptsReturn="True" Height="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" Margin="30,0,0,0" VerticalAlignment="Top">
                    <Button Content="Adicionar Marca" Style="{StaticResource BlueActionButtonStyle}" Margin="0,0,0,10" Click="btnAddMarca_Click"/>
                    <Button Content="Adicionar Fornecedor" Style="{StaticResource BlueActionButtonStyle}" Margin="0,0,0,10" Click="btnAddFornecedor_Click"/>
                    <Button Content="Adicionar Categoria" Style="{StaticResource BlueActionButtonStyle}" Margin="0,0,0,30" Click="btnAddCategoria_Click"/>
                    <Button Content="Cadastrar" Style="{StaticResource PrimaryButtonStyle}" Click="CadastrarButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="PopupOverlay" Visibility="Collapsed">
            <Border Background="#80000000"/>

            <Border x:Name="PopupFornecedor" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="8" BorderBrush="#CCCCCC" BorderThickness="1" Width="400">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="Black" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel Margin="25">
                    <TextBlock Text="Adicionar Fornecedor" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBox Style="{StaticResource PopupTextBoxStyle}" Tag="Nome Fantasia"/>
                    <TextBox Style="{StaticResource PopupTextBoxStyle}" Tag="Razão Social"/>
                    <TextBox Style="{StaticResource PopupTextBoxStyle}" Tag="CNPJ"/>
                    <TextBox Style="{StaticResource PopupTextBoxStyle}" Tag="Email"/>
                    <TextBox Style="{StaticResource PopupTextBoxStyle}" Tag="Telefone Principal"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Adicionar" Style="{StaticResource BlueActionButtonStyle}" Margin="0,10,5,0"/>
                        <Button Grid.Column="1" Content="Cancelar" Style="{StaticResource PopupCancelButtonStyle}" Margin="5,10,0,0" Click="btnCancelar_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="PopupMarca" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="8" BorderBrush="#CCCCCC" BorderThickness="1" Width="350">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="Black" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel Margin="25">
                    <TextBlock Text="Adicionar Marca" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBox Style="{StaticResource PopupTextBoxStyle}" Tag="Nome da Marca"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Adicionar" Style="{StaticResource BlueActionButtonStyle}" Margin="0,10,5,0"/>
                        <Button Grid.Column="1" Content="Cancelar" Style="{StaticResource PopupCancelButtonStyle}" Margin="5,10,0,0" Click="btnCancelar_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="PopupCategoria" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" CornerRadius="8" BorderBrush="#CCCCCC" BorderThickness="1" Width="350">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="Black" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel Margin="25">
                    <TextBlock Text="Adicionar Categoria" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBox Style="{StaticResource PopupTextBoxStyle}" Tag="Nome da Categoria"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Adicionar" Style="{StaticResource BlueActionButtonStyle}" Margin="0,10,5,0"/>
                        <Button Grid.Column="1" Content="Cancelar" Style="{StaticResource PopupCancelButtonStyle}" Margin="5,10,0,0" Click="btnCancelar_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border x:Name="PopupSucesso" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F0FFF4" CornerRadius="8" BorderBrush="#28a745" BorderThickness="1" Width="350">
                <StackPanel Margin="25">
                    <Border Width="60" Height="60" CornerRadius="30" Background="#28a745" HorizontalAlignment="Center">
                        <TextBlock Text="✓" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,5"/>
                    </Border>
                    <TextBlock x:Name="PopupMensagemSucesso" Text="Cadastro realizado com sucesso!" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" Margin="0,15,0,20"/>
                    <Button Content="OK" Style="{StaticResource SuccessButtonStyle}" Width="100" Click="btnPopupOk_Click"/>
                </StackPanel>
            </Border>

            <Border x:Name="PopupErro" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFF0F1" CornerRadius="8" BorderBrush="#dc3545" BorderThickness="1" Width="350">
                <StackPanel Margin="25">
                    <Border Width="60" Height="60" CornerRadius="30" Background="#dc3545" HorizontalAlignment="Center">
                        <TextBlock Text="!" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,5"/>
                    </Border>
                    <TextBlock x:Name="PopupMensagemErro" Text="Ocorreu um erro." FontSize="16" TextWrapping="Wrap" TextAlignment="Center" Margin="0,15,0,20"/>
                    <Button Content="OK" Style="{StaticResource ErrorButtonStyle}" Width="100" Click="btnPopupOk_Click"/>
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Page>