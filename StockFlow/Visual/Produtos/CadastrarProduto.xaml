<Page x:Class="StockFlow.Visual.Produtos.CadastrarProduto"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:StockFlow"
      mc:Ignorable="d"
      Title="CadastroProdutoPage" Background="White">

    <Page.Resources>
        <Style x:Key="BlueActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF33ADFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF2182C3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BlueActionButtonStyle}">
            <Setter Property="Background" Value="#FF1890E0"/>
            <Setter Property="Height" Value="40"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF0368AB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="30,30,0,30">
            <Button Style="{StaticResource BackButtonStyle}" Click="BackButton_Click">
                <ContentControl>
                    <Path Data="M10 0 L0 10 L10 20 Z" Fill="#555" Width="10" Height="20" Stretch="Fill"/>
                </ContentControl>
            </Button>
            <TextBlock Text="Cadastro de Produto" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#333" 
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="30,0,30,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,10">
                    <TextBlock Text="Nome Produto" Margin="0,0,0,5"/>
                    <TextBox Height="30"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                    <TextBlock Text="Unidade de Medida" Margin="0,0,0,5"/>
                    <ComboBox Height="30"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,15,10">
                    <TextBlock Text="Preço de Custo" Margin="0,0,0,5"/>
                    <TextBox Height="30"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                    <TextBlock Text="Estoque Inicial" Margin="0,0,0,5"/>
                    <TextBox Height="30"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,15,10">
                    <TextBlock Text="Preço de Venda" Margin="0,0,0,5"/>
                    <TextBox Height="30"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                    <TextBlock Text="Estoque Mínimo" Margin="0,0,0,5"/>
                    <TextBox Height="30"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Grid.Column="0" Margin="0,0,0,0">
                    <TextBlock Text="Descrição do Produto" Margin="0,0,0,5"/>
                    <TextBox AcceptsReturn="True" Height="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Grid>


            <StackPanel Grid.Column="1" Margin="30,0,0,0" VerticalAlignment="Top">

                <Button Content="Adicionar Marca" Cursor="Hand" Style="{StaticResource BlueActionButtonStyle}" Margin="0,0,0,10" Click="btnAddMarca_Click"/>
                <Button Content="Adicionar Fornecedor" Cursor="Hand" Style="{StaticResource BlueActionButtonStyle}" Margin="0,0,0,10" Click="btnAddFornecedor_Click"/>
                <Button Content="Adicionar Categoria" Cursor="Hand" Style="{StaticResource BlueActionButtonStyle}" Margin="0,0,0,30" Click="btnAddCategoria_Click"/>

                <Button Content="Cadastrar" Cursor="Hand" Style="{StaticResource PrimaryButtonStyle}"/>

            </StackPanel>

        </Grid>
    </Grid>
</Page>