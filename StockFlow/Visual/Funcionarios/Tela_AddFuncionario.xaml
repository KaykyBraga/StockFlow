<UserControl x:Class="StockFlow.Visual.Tela_AddFuncionario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             Background="#F0F0F0">

    <UserControl.Resources>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaseInputStyle" TargetType="{x:Type Control}">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource BaseInputStyle}"/>
        <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource BaseInputStyle}"/>

        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource BaseInputStyle}"/>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="30,30,30,0">
            <Button Style="{StaticResource BackButtonStyle}" Click="BackButton_Click">
                <ContentControl>
                    <Path Data="M10 0 L0 10 L10 20 Z" Fill="#555" Width="10" Height="20" Stretch="Fill"/>
                </ContentControl>
            </Button>

            <TextBlock Text="Adicionar Novo Funcionário" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#333" 
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White" 
                BorderBrush="#CCCCCC" 
                BorderThickness="1"
                CornerRadius="8"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                MinWidth="550" MaxWidth="800" Margin="0,30,0,30">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Preencha os dados do novo colaborador:" FontSize="18" FontWeight="SemiBold" 
                           Grid.ColumnSpan="3" Margin="0,0,0,15"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Nome Completo:" Margin="0,5,15,5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtNomeCompleto" Margin="0,5,0,5"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="ID Funcionário:" Margin="0,15,15,5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtIdFuncionario" Margin="0,15,0,5"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Email:" Margin="0,15,15,5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtEmail" Margin="0,15,0,5"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Tipo de Funcionário:" Margin="0,15,15,5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CmbTipoFuncionario" Margin="0,15,0,5">
                    <ComboBoxItem Content="Gerente"/>
                    <ComboBoxItem Content="Estoquista"/>
                    <ComboBoxItem Content="Vendedor"/>
                </ComboBox>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Senha:" Margin="0,15,15,5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Grid Grid.Row="5" Grid.Column="1" Margin="0,15,0,0">
                    <PasswordBox x:Name="TxtSenha" />
                    <TextBox x:Name="TxtSenhaVisivel" Visibility="Collapsed"/>
                </Grid>

                <CheckBox x:Name="ChkMostrarSenha" 
                          Content="Mostrar Senha" 
                          Grid.Row="5" Grid.Column="2"
                          Margin="10,0,0,0"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left"
                          Checked="ChkMostrarSenha_Checked"
                          Unchecked="ChkMostrarSenha_Unchecked"/>

                <Button Content="Adicionar Funcionário" 
                        Grid.Row="6" Grid.Column="1"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="250"
                        HorizontalAlignment="Center"
                        Click="Button_Click_Adicionar" Margin="0,30,0,0"/>

            </Grid>
        </Border>
    </Grid>
</UserControl>