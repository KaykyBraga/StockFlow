<UserControl x:Class="StockFlow.Visual.Tela_AddFuncionario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800"
             Background="#F0F0F0">


    <Grid>

        <StackPanel VerticalAlignment="Center" Height="450">
            <Button Style="{StaticResource BackButtonStyle}" Click="BackButton_Click" HorizontalAlignment="Left">
                <ContentControl>
                    <Path Data="M10 0 L0 10 L10 20 Z" Fill="#555" Width="10" Height="20" Stretch="Fill"/>
                </ContentControl>
            </Button>
            <TextBlock Text="Adicionar Novo Funcionário" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,30"/>

            <TextBlock Text="Nome Completo:" Margin="0,10,0,5" FontWeight="SemiBold" HorizontalAlignment="Center" Width="464"/>
            <TextBox x:Name="TxtNomeCompleto" Padding="5" FontSize="14" Width="464"/>

            <TextBlock Text="ID Funcionário:" Margin="0,10,0,5" FontWeight="SemiBold" HorizontalAlignment="Center" Width="464"/>
            <TextBox x:Name="TxtIdFuncionario" Padding="5" FontSize="14" HorizontalAlignment="Center" Width="464"/>

            <TextBlock Text="Email:" Margin="0,10,0,5" FontWeight="SemiBold" HorizontalAlignment="Center" Width="464"/>
            <TextBox x:Name="TxtEmail" Padding="5" FontSize="14" HorizontalAlignment="Center" Width="464"/>

            <TextBlock Text="Senha:" Margin="0,10,0,5" FontWeight="SemiBold" HorizontalAlignment="Center" Width="464"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="399*"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="TxtSenha" Padding="5" FontSize="14" HorizontalAlignment="Center" Width="464" Grid.Column="1"/>
                <TextBox x:Name="TxtSenhaVisivel" Padding="5" FontSize="14" Visibility="Collapsed" Grid.ColumnSpan="2"/>
            </Grid>
            <CheckBox x:Name="ChkMostrarSenha" Content="Mostrar Senha" 
                      Margin="0,8,0,20"
                      Checked="ChkMostrarSenha_Checked"
                      Unchecked="ChkMostrarSenha_Unchecked" Width="464"/>

            <Button Content="Adicionar Funcionário" 
                    Height="40" 
                    FontSize="16"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="Button_Click_Adicionar" HorizontalAlignment="Center" Width="219">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#007ACC"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>