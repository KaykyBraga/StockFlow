<Window x:Class="StockFlow.Visual.Tela_Vendas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StockFlow - Sistema de Vendas" Height="700" Width="1400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="48"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#E8E8E8" BorderBrush="#999999" BorderThickness="0,0,0,3">
            <TextBlock HorizontalAlignment="Left" Height="64" Margin="112,18,0,0" TextWrapping="Wrap" Text="StockFlow" VerticalAlignment="Top" Width="272" FontSize="48" FontFamily="Arial"/>
        </Border>

        <!-- Conteúdo Principal -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Esquerda -->
            <Border Grid.Column="0" Background="#D3D3D3" BorderBrush="#999999" BorderThickness="0,0,2,0">
                <Grid>
                    <TextBlock Text="Vendas" FontSize="36" FontWeight="Bold" 
                               Margin="20,30,20,20" HorizontalAlignment="Center"
                               VerticalAlignment="Top"/>

                    <StackPanel VerticalAlignment="Bottom" Margin="20">
                        <Button x:Name="BtnFecharCaixa" Content="Fechar Caixa" 
                                Background="#FF9800" Foreground="White" 
                                Style="{StaticResource ButtonStyle}"
                                BorderBrush="#F57C00" Margin="0,0,0,15"
                                Click="BtnFecharCaixa_Click"/>

                        <Button Content="Sair" Background="#E74C3C" 
                                Foreground="White" Style="{StaticResource ButtonStyle}"
                                BorderBrush="#C0392B"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Área Principal -->
            <Grid Grid.Column="1" Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Nova Venda" Style="{StaticResource SectionTitleStyle}" 
                           HorizontalAlignment="Center" Grid.Row="0" Margin="0,0,0,20"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Seção Buscar Produto -->
                    <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="2" 
                            CornerRadius="8" Padding="20" Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="Buscar Produto" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                            <ComboBox FontSize="14" Padding="10" Margin="0,0,0,20">
                                <ComboBoxItem Content="selecione o produto..." IsSelected="True"/>
                            </ComboBox>

                            <Button Content="Adicionar" 
                                    Background="#5DADE2" Foreground="White" 
                                    Style="{StaticResource ButtonStyle}" BorderBrush="#3498DB"/>
                        </StackPanel>
                    </Border>

                    <!-- Seção Itens da Venda -->
                    <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="2" 
                            CornerRadius="8" Padding="20" Margin="0,0,15,0"/>

                    <!-- Seção Conclusão da Venda -->
                    <Border Grid.Column="2" BorderBrush="#CCCCCC" BorderThickness="2" 
                            CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Conclusão da Venda" FontSize="18" FontWeight="SemiBold" 
                                       Margin="0,0,0,20" TextWrapping="Wrap"/>

                            <TextBlock Text="Total da Venda" FontSize="16" Foreground="#27AE60" 
                                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,10"/>
                            <TextBox Text="R$ 00,00" FontSize="28" FontWeight="Bold" 
                                     HorizontalAlignment="Center" Margin="0,0,0,30"
                                     IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     TextAlignment="Center" Cursor="IBeam" IsReadOnlyCaretVisible="True"/>

                            <Button Content="Cartão" Background="#5DADE2" Foreground="White" 
                                    Style="{StaticResource ButtonStyle}" Margin="0,0,0,15" BorderBrush="#3498DB"/>
                            <Button Content="Dinheiro" Background="#27AE60" Foreground="White" 
                                    Style="{StaticResource ButtonStyle}" Margin="0,0,0,15" BorderBrush="#229954"/>
                            <Button Content="Pix" Background="#F39C12" Foreground="White" 
                                    Style="{StaticResource ButtonStyle}" Margin="0,0,0,15" BorderBrush="#E67E22"/>
                            <Button Content="Finalizar Venda" Background="#5DADE2" Foreground="White" 
                                    Style="{StaticResource ButtonStyle}" FontWeight="Bold" BorderBrush="#3498DB"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        <Image Source="/Imagens/Armazem.png" Stretch="Fill" Height="80" VerticalAlignment="Center" HorizontalAlignment="Left" Width="100" Margin="10,0,0,0"/>
        <Image Margin="33,182,1160,182" Grid.Row="1" Source="/Imagens/Caixa.png" Stretch="Fill"/>
    </Grid>
</Window>