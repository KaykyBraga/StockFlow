<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="StockFlow.Visual.Tela_Vendas"
        Title="StockFlow - Sistema de Vendas" Height="700" Width="1400"
        MinHeight="720"
        MinWidth="1280"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="HeaderStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="48"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E8E8E8" BorderBrush="#999999" BorderThickness="0,0,0,3">
            <TextBlock HorizontalAlignment="Left" Height="64" Margin="112,18,0,0" TextWrapping="Wrap" Text="StockFlow" VerticalAlignment="Top" Width="272" FontSize="48" FontFamily="Arial" FontWeight="Bold"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#D3D3D3" BorderBrush="#999999" BorderThickness="0,0,2,0">
                <Grid>
                    <TextBlock Text="Vendas" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Top" Margin="0,6,0,0"/>

                    <StackPanel VerticalAlignment="Bottom" Margin="20">
                        <Button
                                Style="{StaticResource ButtonStyle}"
                                x:Name="BtnAbrirCaixa" Foreground="White"
                                Content="Abrir Caixa" Margin="0,0,0,15"
                                BorderBrush="#FF4698CE" Background="#5DADE2"
                                Click="BtnAbrirCaixa_Click" Height="37"/>
                        <Button x:Name="BtnSangria" Content="Sangria de Caixa" 
                                Background="#E67E22" Foreground="White" 
                                Style="{StaticResource ButtonStyle}"
                                BorderBrush="#D35400" Margin="0,0,0,15"
                                Click="BtnSangria_Click" Height="37"/>
                        <Button x:Name="BtnAdicionarTroco" Content="Adicionar Troco" 
                                Background="#2ECC71" Foreground="White" 
                                Style="{StaticResource ButtonStyle}"
                                BorderBrush="#27AE60" Margin="0,0,0,15"
                                Click="BtnAdicionarTroco_Click" Height="37"/>

                        <Button x:Name="BtnFecharCaixa" Content="Fechar Caixa" 
                                Background="#FF9800" Foreground="White" 
                                Style="{StaticResource ButtonStyle}"
                                BorderBrush="#F57C00" Margin="0,0,0,15"
                                Click="BtnFecharCaixa_Click" Height="37" Visibility="Collapsed"/>

                        <Button x:Name="BtnSair" Content="Sair" Background="#E74C3C" 
                                Foreground="White" Style="{StaticResource ButtonStyle}"
                                BorderBrush="#C0392B" Height="37" Click="BtnSair_Click"/>
                    </StackPanel>
                    <Grid>
                    <Image Source="/Imagens/Caixa.png" Margin="35,83,35,281" Stretch="Uniform"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="GridVendaPrincipal" Grid.Column="1" Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Nova Venda" Style="{StaticResource SectionTitleStyle}" 
                               HorizontalAlignment="Center" Grid.Row="0" Margin="0,0,0,20"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="2"
                            CornerRadius="8" Padding="20" Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="Buscar Produto" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                            <TextBlock Text="Digite ou selecione o produto:" FontSize="14" Margin="0,0,0,5"/>

                            <ComboBox x:Name="ComboBuscarProduto"
                                      FontSize="14"
                                      Padding="8"
                                      Margin="0,0,0,20"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      StaysOpenOnEdit="True"
                                      KeyUp="ComboBuscarProduto_KeyUp"/>

                            <Button x:Name="BtnAdicionar" Content="Adicionar"
                                    Background="#5DADE2" Foreground="White"
                                    Style="{StaticResource ButtonStyle}" BorderBrush="#3498DB"
                                    Click="BtnAdicionar_Click" Height="37"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="2" 
                                CornerRadius="8" Padding="20" Margin="0,0,15,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Itens da Venda" FontSize="18" FontWeight="SemiBold" 
                                       Margin="0,0,0,15" Grid.Row="0" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PainelItensVenda"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="#CCCCCC" BorderThickness="2" 
                                CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Conclusão da Venda" FontSize="18" FontWeight="SemiBold" 
                                       Margin="0,0,0,20" TextWrapping="Wrap"/>
                            <TextBlock Text="Total da Venda" FontSize="16" Foreground="#27AE60" 
                                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,10"/>
                            <TextBox x:Name="TxtTotalVenda" Text="R$ 00,00" FontSize="28" FontWeight="Bold" 
                                     HorizontalAlignment="Center" Margin="0,0,0,30"
                                     IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     TextAlignment="Center" Cursor="IBeam" IsReadOnlyCaretVisible="True"/>
                            <Button x:Name="BtnPagamentoCartao" Content="Cartão" Background="#5DADE2" Foreground="White" 
                                    Style="{StaticResource ButtonStyle}" Margin="0,0,0,15" BorderBrush="#3498DB" Height="37" Click="BtnPagamento_Click"/>
                            <Button x:Name="BtnPagamentoDinheiro" Content="Dinheiro" Background="#27AE60" Foreground="White" 
                                    Style="{StaticResource ButtonStyle}" Margin="0,0,0,15" BorderBrush="#229954" Height="37" Click="BtnPagamento_Click"/>
                            <Button x:Name="BtnPagamentoPix" Content="Pix" Background="#F39C12" Foreground="White" 
                                    Style="{StaticResource ButtonStyle}" Margin="0,0,0,15" BorderBrush="#E67E22" Height="37" Click="BtnPagamento_Click"/>
                            <Button x:Name="BtnFinalizarVenda" Content="Finalizar Venda" Background="#5DADE2" Foreground="White" 
                                    Style="{StaticResource ButtonStyle}" FontWeight="Bold" BorderBrush="#3498DB" Height="37" Click="BtnFinalizarVenda_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Image Source="/Imagens/Armazem.png" Stretch="Fill" Height="80" VerticalAlignment="Center" HorizontalAlignment="Left" Width="100" Margin="10,0,0,0"/>
    </Grid>
</Window>