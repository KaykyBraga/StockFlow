<Page x:Class="StockFlow.Visual.RecoveryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d"
      Title="RecoveryPage" Height="446">

    <Page.Resources>
        <Style x:Key="BaseActionButtonStyle" TargetType="{x:Type Button}">
            <Style.Setters>
                <Setter Property="Background" Value="#FF33ADFF"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Height" Value="35"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style.Setters>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF2182C3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseActionButtonStyle}">
            <Style.Setters>
                <Setter Property="Background" Value="#1890E0"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Width" Value="300"/>
                <Setter Property="Height" Value="45"/>
                <Setter Property="Foreground" Value="White"/>
            </Style.Setters>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0368AB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource {x:Type TextBox}}"/>

    </Page.Resources>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Recuperação de Senha" 
                   FontSize="28" 
                   FontWeight="SemiBold" 
                   HorizontalAlignment="Center" 
                   Foreground="#333333" Margin="0,0,0,25"/>

        <TextBlock Grid.Row="1" Text="ID do Funcionário" Margin="0,0,0,5" Foreground="#555555"/>
        <TextBox x:Name="txtIdFuncionario" Grid.Row="2" Height="35" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="3" Text="Email" Margin="0,0,0,5" Foreground="#555555"/>
        <TextBox Grid.Row="4" x:Name="TxtEmail" Height="35" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="5" Text="Nova Senha" Margin="0,0,0,5" Foreground="#555555"/>
        <TextBox Grid.Row="6" x:Name="TxtNovaSenha" Height="35" Margin="0,0,0,15"/>

        <Button Grid.Row="7" 
                Content="Confirmar" 
                Style="{StaticResource PrimaryActionButtonStyle}" FontWeight="Bold" FontSize="16" Click="Button_Click"/>
        <TextBlock Grid.Row="8" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Hyperlink Click="Hyperlink_Login_Click">
                <Run Text="&lt; Voltar para o Login"/>
            </Hyperlink>
        </TextBlock>
    </Grid>
</Page>