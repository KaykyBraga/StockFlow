<Page x:Class="StockFlow.Visual.Relatorio.Caixa"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StockFlow.Visual.Relatorio"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="RelatorioCaixa"
      Background="#F0F0F0">

    <Page.Resources>
        <Style x:Key="BaseActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF33ADFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF2182C3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseActionButtonStyle}">
            <Setter Property="Background" Value="#1890E0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="35"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0368AB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Relatório de Caixa" 
                   FontSize="28" 
                   FontWeight="Bold" 
                   VerticalAlignment="Center"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="White" Padding="15" CornerRadius="5" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Filtros" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Data Início:" VerticalAlignment="Center" Margin="5"/>
                    <DatePicker Grid.Column="1" x:Name="DpDataInicio" VerticalAlignment="Center" Margin="5" FontSize="14"/>
                    <TextBlock Grid.Column="2" Text="Data Fim:" VerticalAlignment="Center" Margin="5"/>
                    <DatePicker Grid.Column="3" x:Name="DpDataFim" VerticalAlignment="Center" Margin="5" FontSize="14"/>

                    <TextBlock Grid.Column="4" Text="ID Usuário:" VerticalAlignment="Center" Margin="15,5,5,5"/>
                    <ComboBox Grid.Column="5" x:Name="CboIdUsuario" VerticalAlignment="Center" Margin="5" FontSize="14"/>

                    <Button Grid.Column="6" x:Name="BtnFiltrar" Content="Filtrar" 
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Margin="20,5,5,5" 
                            Click="BtnFiltrar_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <DataGrid x:Name="dgCaixa" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" 
                  CanUserAddRows="False"
                  FontSize="14"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID Caixa" Binding="{Binding IdCaixa}" Width="*"/>
                <DataGridTextColumn Header="ID Usuário" Binding="{Binding IdUsuario}" Width="*"/>
                <DataGridTextColumn Header="Data e Hora da Abertura" Binding="{Binding DataAbertura, StringFormat='dd/MM/yyyy HH:mm'}" Width="2*"/>
                <DataGridTextColumn Header="Vlr. Abertura" Binding="{Binding ValorAbertura, StringFormat=C2, ConverterCulture='pt-BR'}" Width="*"/>
                <DataGridTextColumn Header="Data e Hora do Fechamento" Binding="{Binding DataFechamento, StringFormat='dd/MM/yyyy HH:mm'}" Width="2*"/>
                <DataGridTextColumn Header="Vlr. Fechamento" Binding="{Binding ValorFechamento, StringFormat=C2, ConverterCulture='pt-BR'}" Width="*"/>
                <DataGridTextColumn Header="Diferença" Binding="{Binding Diferenca, StringFormat=C2, ConverterCulture='pt-BR'}" Width="*">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DiferencaNegativa}" Value="True">
                                    <Setter Property="Foreground" Value="Red"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" FontWeight="Bold"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>