<Page x:Class="StockFlow.Visual.Relatorio.InfoVenda"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StockFlow.Visual.Relatorio"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="InfoVenda"
      Background="#F0F0F0">

    <Page.Resources>
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111"/>
        </Style>

    </Page.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource BackButtonStyle}" Click="BackButton_Click" HorizontalAlignment="Left" Width="20">
                <ContentControl>
                    <Path Data="M10 0 L0 10 L10 20 Z" Fill="#555" Width="10" Height="20" Stretch="Fill"/>
                </ContentControl>
            </Button>

            <TextBlock Grid.Column="1" 
                       Text="Detalhes da Venda" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"/>
        </Grid>

        <Border Grid.Row="1" 
                Background="White" 
                Padding="20" 
                CornerRadius="5" 
                BorderBrush="#DDD" 
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ID DA VENDA" Style="{StaticResource LabelTextStyle}"/>
                    <TextBlock x:Name="txtIdVenda" Style="{StaticResource ValueTextStyle}" Text="#12345"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="DATA E HORA" Style="{StaticResource LabelTextStyle}"/>
                    <TextBlock x:Name="txtDataVenda" Style="{StaticResource ValueTextStyle}" Text="24/10/2025 18:30"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="FUNCIONÁRIO" Style="{StaticResource LabelTextStyle}"/>
                    <TextBlock x:Name="txtFuncionario" Style="{StaticResource ValueTextStyle}" Text="Nome do Vendedor"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="MÉTODO DE PAGAMENTO" Style="{StaticResource LabelTextStyle}"/>
                    <TextBlock x:Name="txtMetodoPgto" Style="{StaticResource ValueTextStyle}" Text="Cartão de Crédito"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2" x:Name="DgItensVenda" 
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  FontSize="14"
                  ColumnWidth="*"
                  Margin="0,20,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Produto" Binding="{Binding NomeProduto}" Width="3*"/>
                <DataGridTextColumn Header="Qtd." Binding="{Binding Quantidade}" Width="80"/>
                <DataGridTextColumn Header="Preço Unit." Binding="{Binding PrecoUnitario, StringFormat=C, ConverterCulture=pt-BR}" Width="120"/>
                <DataGridTextColumn Header="Total" Binding="{Binding PrecoTotal, StringFormat=C, ConverterCulture=pt-BR}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal:" 
                       FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock x:Name="txtSubtotal" Grid.Row="0" Grid.Column="1" Text="R$ 150,00" 
                       FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,5"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Desconto:" 
                       FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock x:Name="txtDesconto" Grid.Row="1" Grid.Column="1" Text="R$ 10,00" 
                       FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,5"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="TOTAL PAGO:" 
                       FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock x:Name="txtTotalVenda" Grid.Row="2" Grid.Column="1" Text="R$ 140,00" 
                       FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,5"/>

        </Grid>

    </Grid>
</Page>