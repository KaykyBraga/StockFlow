<UserControl x:Class="StockFlow.Visual.Tela_RelatorioMovimentacao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="#F0F0F0">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Relatório de Movimentação de Estoque" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Margin="0,0,0,20"/>

            <Border Background="White" Padding="15" CornerRadius="5" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Filtros" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Período:" VerticalAlignment="Center" Margin="5"/>
                        <DatePicker Grid.Column="1" x:Name="DpDataInicio" VerticalAlignment="Center" Margin="5" FontSize="14"/>
                        <DatePicker Grid.Column="2" x:Name="DpDataFim" VerticalAlignment="Center" Margin="5" FontSize="14"/>

                        <TextBlock Grid.Column="3" Text="Tipo:" VerticalAlignment="Center" Margin="15,5,5,5"/>
                        <ComboBox Grid.Column="4" x:Name="CboTipoMovimentacao" VerticalAlignment="Center" Margin="5" FontSize="14"/>

                        <TextBlock Grid.Column="5" Text="Funcionário:" VerticalAlignment="Center" Margin="15,5,5,5"/>
                        <ComboBox Grid.Column="6" x:Name="CboFuncionarios" VerticalAlignment="Center" Margin="5" FontSize="14"/>

                        <Button Grid.Column="7" x:Name="BtnFiltrar" Content="Filtrar" Width="120" Height="35" Margin="20,5,5,5" Click="BtnFiltrar_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <DataGrid x:Name="DgMovimentacoes" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      FontSize="14"
                      ColumnWidth="*">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Binding="{Binding Data, StringFormat='dd/MM/yyyy HH:mm'}" Width="150"/>
                    <DataGridTextColumn Header="Produto" Binding="{Binding NomeProduto}" Width="*"/>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="120"/>
                    <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade}" Width="120"/>
                    <DataGridTextColumn Header="Funcionário" Binding="{Binding NomeFuncionario}" Width="200"/>
                    <DataGridTextColumn Header="Observação" Binding="{Binding Observacao}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>