<Page x:Class="StockFlow.Visual.AlertasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StockFlow"
      mc:Ignorable="d" 
      Title="AlertasPage" Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,20">

            <Button Style="{StaticResource BackButtonStyle}" Click="BackButton_Click">
                <ContentControl>
                    <Path Data="M10 0 L0 10 L10 20 Z" Fill="#555" Width="10" Height="20" Stretch="Fill"/>
                </ContentControl>
            </Button>

            <TextBlock Text="Alertas!!" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#333" 
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5">
            <DataGrid x:Name="DataGridAlertas" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      GridLinesVisibility="All"
                      ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Estado de Atenção" 
                                        Binding="{Binding EstadoAtencao}" 
                                        Width="*"/>

                    <DataGridTextColumn Header="Precisa de Reposição" 
                                        Binding="{Binding ReposicaoNecessaria}" 
                                        Width="*"/>
                </DataGrid.Columns>

            </DataGrid>
        </Border>
    </Grid>
</Page>