<Page x:Class="StockFlow.Visual.BoasVindasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StockFlow.Visual"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BoasVindasPage">

    <Page.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
    </Page.Resources>
    
    <Grid Background="White">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" TextBlock.TextAlignment="Center">

            <Image Source="/Imagens/Armazem.png" 
                   Height="100" 
                   Width="100" 
                   Margin="0,0,0,20" 
                   Opacity="0.7"/>

            <TextBlock FontSize="32" Foreground="#444">
                <Run Text="Seja Bem Vindo ao " FontWeight="SemiBold"/>
                <Run Text="StockFlow" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            </TextBlock>

            <TextBlock Text="O sistema de gerenciamento da sua Loja de Eletrônicos"
                       FontSize="18" 
                       Foreground="#666" 
                       Margin="0,10,0,0"/>

        </StackPanel>
    </Grid>
</Page>