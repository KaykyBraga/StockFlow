<Window x:Class="StockFlow.Visual.Tela_Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StockFlow"
        mc:Ignorable="d"
        Title="StockFlow - Login" Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#F0F0F0">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="50,0,50,0">
            <Image Source="D:\TRABALHO FACULDADE\Imagemm_tela_Login.png" 
                   Width="300" Height="250" Margin="0,0,0,20"/>

            <TextBlock Text="StockFlow" 
                       FontSize="36" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Foreground="#333333"/>
        </StackPanel>

        <Border Grid.Column="1" 
                Background="White" 
                BorderBrush="#CCCCCC" 
                BorderThickness="1"
                Margin="20,50"
                CornerRadius="8">

            <Frame x:Name="ContentFrame" 
                   NavigationUIVisibility="Hidden" 
                   Margin="20"/>

        </Border>
    </Grid>
</Window>