<UserControl x:Class="StockFlow.Visual.Tela_AddFuncionario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800"
             Background="#F0F0F0">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
            <TextBlock Text="Adicionar Novo Funcionário" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,30"/>

            <TextBlock Text="Nome Completo:" Margin="0,10,0,5" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtNomeCompleto" Padding="5" FontSize="14"/>

            <TextBlock Text="ID Funcionário:" Margin="0,10,0,5" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtIdFuncionario" Padding="5" FontSize="14"/>

            <TextBlock Text="Email:" Margin="0,10,0,5" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtEmail" Padding="5" FontSize="14"/>

            <TextBlock Text="Senha:" Margin="0,10,0,5" FontWeight="SemiBold"/>
            <Grid>
                <PasswordBox x:Name="TxtSenha" Padding="5" FontSize="14"/>
                <TextBox x:Name="TxtSenhaVisivel" Padding="5" FontSize="14" Visibility="Collapsed"/>
            </Grid>
            <CheckBox x:Name="ChkMostrarSenha" Content="Mostrar Senha" 
                      Margin="0,8,0,20"
                      Checked="ChkMostrarSenha_Checked"
                      Unchecked="ChkMostrarSenha_Unchecked"/>

            <Button Content="Adicionar Funcionário" 
                    Height="40" 
                    FontSize="16"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="Button_Click_Adicionar">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#007ACC"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>